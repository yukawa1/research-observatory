---
import Base from '../../layouts/Base.astro';
import papers from '../../data/papers.json';
export function getStaticPaths(){return papers.map(p=>({params:{id:p.id},props:{paper:p}}))}
const {paper:p}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<Base title={p.title} description={p.abstract}><section class="detail shell"><a class="back-link" href={base+'/'}>← BACK TO THE OBSERVATORY</a><div class="detail-header"><div class="eyebrow orange">RESEARCH NOTE / {p.category} / {p.id}</div><h1>{p.title}</h1><div class="detail-authors">{p.authors.join(' · ')}</div><div class="detail-badges"><span class="tag">{p.status}</span><span class="tag">{p.review_status==='curated'?'Curated interpretation':'Metadata only'}</span><span class="tag">{p.evidence_level||'Abstract only'}</span></div><div class="detail-cta"><a class="primary-btn" href={p.link} target="_blank" rel="noopener noreferrer">Read original on arXiv ↗</a><span>Published {p.published} · Last updated {p.updated}</span></div></div><div class="reading-layout"><div class="article-body"><div class="eyebrow orange">01 / AT A GLANCE</div><h2>In plain language</h2><p class="pull">{p.lay_summary||'This paper is indexed from arXiv. A simplified explanation has not yet been reviewed.'}</p><hr/><div class="eyebrow orange">02 / THE RESEARCH</div><h2>Scientific overview</h2><p>{p.scientific_summary||p.abstract}</p><div class="evidence"><strong>Evidence note</strong><p>{p.caveat||'The summary above is derived from author-provided abstract metadata. It is not an independent review or validation of the complete study.'}</p></div><hr/><div class="eyebrow orange">03 / SOURCE</div><h2>Reference</h2><p>{p.reference||p.authors.join(', ')+'. '+p.title+'. arXiv:'+p.id+'.'}</p><p class="citation"><a href={p.link} target="_blank" rel="noopener noreferrer">{p.link} ↗</a></p><p class="footnote">This website is an independent discovery aid, not a substitute for reading the original research. arXiv preprints may not have undergone peer review.</p></div><aside class="sidebar"><div class="sidebar-title">PAPER DOSSIER</div><dl><dt>arXiv identifier</dt><dd>{p.id}</dd><dt>Primary category</dt><dd>{p.category}</dd><dt>First published</dt><dd>{p.published}</dd><dt>Publication status</dt><dd>{p.status}</dd><dt>Analysis status</dt><dd>{p.review_status==='curated'?'Curated / editorial':'Metadata / author abstract'}</dd></dl><div class="sidebar-title">RESEARCH THEMES</div><div class="tagline">{p.tags.map(t=><span class="tag">{t}</span>)}</div><a href={base+'/'} class="sidebar-return">← All research</a></aside></div></section></Base>