---
import Base from '../layouts/Base.astro';
import papers from '../data/papers.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const items=[...papers].sort((a,b)=>b.published.localeCompare(a.published)||b.score-a.score);
const last=items[0]?.published||'';
const curated=items.filter(p=>p.review_status==='curated').length;
---
<Base title="Discover new science" description="An evidence-aware window into new active galactic nuclei research.">
<section class="hero shell"><div class="eyebrow"><span class="live-dot"></span> THE DAILY SCIENCE BRIEFING <span class="line"></span> ACTIVE GALACTIC NUCLEI</div><div class="hero-grid"><div><h1>A clearer view of <em>new science.</em></h1><p class="lead">The latest research, carefully organized. Explore discoveries about black holes and active galaxies—from the original source to a human-readable explanation.</p><div class="hero-actions"><a class="primary-btn" href="#archive">Explore research <span>↗</span></a><a class="secondary-btn" href={base+'/about/'}>How it works <span>↗</span></a></div></div><div class="orbit-art" aria-hidden="true"><div class="orb-ring r1"></div><div class="orb-ring r2"></div><div class="orb-ring r3"></div><div class="orb-core"></div><span class="star s1">✦</span><span class="star s2">✧</span><span class="orbit-label">AGN / 001</span></div></div><div class="hero-metrics"><div><strong>{items.length.toString().padStart(2,'0')}</strong><span>RESEARCH PAPERS</span></div><div><strong>{curated.toString().padStart(2,'0')}</strong><span>CURATED READINGS</span></div><div><strong>{last||'—'}</strong><span>LATEST SOURCE DATE</span></div></div></section>
<section class="content-section shell" id="archive"><div class="section-top"><div><div class="eyebrow orange">THE OBSERVATORY / ISSUE 001</div><h2>On the horizon<span class="period">.</span></h2><p>Research selected for relevance, with its evidence status always visible.</p></div><span class="issue-tag">AGN RESEARCH DESK · UPDATED DAILY</span></div><div class="toolbar"><label class="search-field"><span>⌕</span><input id="search" type="search" placeholder="Search titles, topics, authors…" autocomplete="off"/><kbd>/</kbd></label><div class="filters" role="group" aria-label="Filter research"><button class="filter active" data-filter="all" aria-pressed="true">All papers</button><button class="filter" data-filter="BLR" aria-pressed="false">Broad-line region</button><button class="filter" data-filter="Variability" aria-pressed="false">Variability</button><button class="filter" data-filter="Spectroscopy" aria-pressed="false">Spectroscopy</button></div></div><div class="paper-list" id="papers">{items.map((p,i)=><article class="paper-card" data-search={(p.title+' '+p.authors.join(' ')+' '+p.tags.join(' ')+' '+p.abstract).toLowerCase()} data-tags={p.tags.join('|')}><div class="paper-index">{String(i+1).padStart(2,'0')} <span> / {p.category}</span></div><div class="paper-main"><div class="paper-meta"><time datetime={p.published}>{new Date(p.published+'T00:00:00Z').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span class="sep">◆</span><span>{p.review_status==='curated'?'CURATED READING':'METADATA ONLY'}</span><span class="sep">◆</span><span>{p.status}</span></div><h3><a href={base+'/papers/'+p.id+'/'}>{p.title}</a></h3><p class="paper-authors">{p.authors.slice(0,3).join(', ')}{p.authors.length>3?' et al.':''}</p><p class="paper-summary">{p.lay_summary || p.abstract}</p><div class="tagline">{p.tags.map(t=><span class="tag">{t}</span>)}</div></div><a class="paper-arrow" href={base+'/papers/'+p.id+'/'} aria-label={'Read '+p.title}>↗</a></article>)}</div><div id="no-results" class="empty" hidden>No papers match this search. Try another keyword or filter.</div><div class="under-note"><span>✳</span> New publications are collected automatically. Scientific interpretations appear only when curated; metadata-only entries are labeled accordingly.</div></section>
<section class="feature-band"><div class="shell feature-grid"><div><div class="eyebrow orange">BEYOND THE ABSTRACT</div><h2>Not just what’s new.<br/><em>Why it matters.</em></h2></div><div><p>A paper is more than a headline. We separate what researchers measured from what they inferred—and what remains uncertain.</p><a href={base+'/about/'}>Explore our editorial approach ↗</a></div></div></section>
<script>const input=document.querySelector('#search');const buttons=[...document.querySelectorAll('.filter')];let active='all';const cards=[...document.querySelectorAll('.paper-card')];function apply(){const q=input.value.toLowerCase().trim();let n=0;cards.forEach(c=>{const visible=c.dataset.search.includes(q)&&(active==='all'||c.dataset.tags.toLowerCase().includes(active.toLowerCase()));c.hidden=!visible;if(visible)n++});document.querySelector('#no-results').hidden=n>0}input.addEventListener('input',apply);buttons.forEach(b=>b.addEventListener('click',()=>{active=b.dataset.filter;buttons.forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-pressed',String(x===b))});apply()}));document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();input.focus()}})</script>
</Base>