---
import Base from '../layouts/Base.astro';
import papers from '../data/papers.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const detailed=papers.filter(p=>p.review_status==='curated'&&p.analysis);
const items=[...papers].sort((a,b)=>(Number(Boolean(b.analysis))-Number(Boolean(a.analysis)))||b.published.localeCompare(a.published)||b.score-a.score);
const latest=[...papers].sort((a,b)=>b.published.localeCompare(a.published))[0]?.published||'';
const pending=papers.length-detailed.length;
const short=(s,limit=235)=>s.length>limit?s.slice(0,limit).replace(/\s+\S*$/,'').trim()+'…':s;
---
<Base title="AGN literature, clearly organized" description="Find detailed scientific AGN research notes, with source-linked evidence, or browse the full arXiv feed.">
<section class="hero shell">
  <div class="eyebrow"><span class="live-dot"></span> THE DAILY SCIENCE BRIEFING <span class="line"></span> ACTIVE GALACTIC NUCLEI</div>
  <div class="hero-grid"><div>
    <h1>A clearer view of <em>new science.</em></h1>
    <p class="lead">Find research worth reading, then go beyond the headline. Detailed analyses are separated from automatically indexed arXiv abstracts.</p>
    <div class="hero-actions"><a class="primary-btn" href="#archive">Read analyses <span>↗</span></a><a class="secondary-btn" href={base+'/about/'}>How it works <span>↗</span></a></div>
  </div><div class="orbit-art" aria-hidden="true"><div class="orb-ring r1"></div><div class="orb-ring r2"></div><div class="orb-ring r3"></div><div class="orb-core"></div><span class="star s1">✦</span><span class="star s2">✧</span><span class="orbit-label">AGN / 001</span></div></div>
  <div class="hero-metrics"><div><strong>{detailed.length.toString().padStart(2,'0')}</strong><span>DETAILED ANALYSES</span></div><div><strong>{pending.toString().padStart(2,'0')}</strong><span>ABSTRACTS AWAITING ANALYSIS</span></div><div><strong>{latest||'—'}</strong><span>LATEST SOURCE DATE</span></div></div>
</section>
<section class="content-section shell" id="archive">
  <div class="section-top"><div><div class="eyebrow orange">THE OBSERVATORY / RESEARCH LIBRARY</div><h2>Research archive<span class="period">.</span></h2><p>Start with papers that have an explanation, or open the complete automatically collected feed.</p></div><span class="issue-tag">SOURCE-LINKED · CLEAR EVIDENCE LEVELS</span></div>
  <div class="analysis-nav" role="group" aria-label="Analysis availability">
    <button class="view-filter active" type="button" data-mode="analyzed" aria-pressed="true"><span class="view-symbol">✦</span> Detailed analyses <strong>{detailed.length}</strong></button>
    <button class="view-filter" type="button" data-mode="all" aria-pressed="false">All papers <strong>{papers.length}</strong></button>
    <button class="view-filter" type="button" data-mode="abstract" aria-pressed="false">Abstract only <strong>{pending}</strong></button>
  </div>
  <p class="view-explainer" id="view-explainer">Showing research notes with a plain-language explanation, methodology, key results, limitations and interpretation.</p>
  <div class="toolbar"><label class="search-field"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Search titles, topics, authors…" autocomplete="off" aria-label="Search research papers"/><kbd>/</kbd></label><div class="filters" role="group" aria-label="Filter by topic"><button class="filter active" type="button" data-filter="all" aria-pressed="true">All topics</button><button class="filter" type="button" data-filter="BLR" aria-pressed="false">BLR</button><button class="filter" type="button" data-filter="Variability" aria-pressed="false">Variability</button><button class="filter" type="button" data-filter="Spectroscopy" aria-pressed="false">Spectroscopy</button></div></div>
  <div class="result-info" id="result-count" aria-live="polite">{detailed.length} detailed analyses</div>
  <div class="paper-list" id="papers">{items.map((p,i)=>{
    const hasAnalysis=p.review_status==='curated'&&Boolean(p.analysis);
    return <article class="paper-card" data-readiness={hasAnalysis?'analyzed':'abstract'} data-search={(p.title+' '+p.authors.join(' ')+' '+p.tags.join(' ')+' '+p.abstract).toLowerCase()} data-tags={p.tags.join('|')} hidden={!hasAnalysis}>
      <div class="paper-index">{String(i+1).padStart(2,'0')} <span> / {p.category}</span></div>
      <div class="paper-main">
        <div class="paper-meta"><span class={'readiness-label '+(hasAnalysis?'complete':'pending')}>{hasAnalysis?'✦ DETAILED ANALYSIS':'○ ABSTRACT ONLY'}</span><time datetime={p.published}>{new Date(p.published+'T00:00:00Z').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span>{p.status}</span></div>
        <h3><a href={base+'/papers/'+p.id+'/'}>{p.title}</a></h3>
        <p class="paper-authors">{p.authors.slice(0,3).join(', ')}{p.authors.length>3?' et al.':''}</p>
        {hasAnalysis&&p.comic&&<a class="comic-preview-link" href={base+'/papers/'+p.id+'/#comic-explainer'} aria-label={'View comic explainer for '+p.title}><img class="comic-preview" src={base+'/'+p.comic} alt={p.comic_alt} loading="lazy" decoding="async" width="1200" height="770"/><span class="comic-preview-caption">Illustrated comic explainer <span aria-hidden="true">↗</span></span></a>}
        <p class="paper-summary">{hasAnalysis?short(p.lay_summary||p.scientific_summary,290):short(p.abstract||'',230)}</p>
        <div class="tagline">{p.tags.map(t=><span class="tag">{t}</span>)}</div>
        <a class="paper-read-link" href={base+'/papers/'+p.id+'/'}>{hasAnalysis?'Read full analysis':'View source abstract'} <span aria-hidden="true">↗</span></a>
      </div>
      <a class="paper-arrow" href={base+'/papers/'+p.id+'/'} aria-label={(hasAnalysis?'Read detailed analysis of ':'View abstract for ')+p.title}>↗</a>
    </article>
  })}</div>
  <div id="no-results" class="empty" hidden>No papers match these filters. Try another topic, search term or switch to “All papers”.</div>
  <div class="under-note"><span>✳</span>Only reviewed notes have scientific explanations. Newly collected records are kept as author abstracts until an editor prepares a source-linked analysis.</div>
</section>
<section class="feature-band"><div class="shell feature-grid"><div><div class="eyebrow orange">BEYOND THE ABSTRACT</div><h2>Not just what’s new.<br/><em>Why it matters.</em></h2></div><div><p>Each detailed reading separates the research question, methods, measured results, interpretation and uncertainties. Metadata-only records never masquerade as reviewed research.</p><a href={base+'/about/'}>Explore our editorial approach ↗</a></div></div></section>
<script>
const input=document.querySelector('#search');
const topicButtons=[...document.querySelectorAll('.filter')];
const modeButtons=[...document.querySelectorAll('.view-filter')];
const cards=[...document.querySelectorAll('.paper-card')];
let mode='analyzed',topic='all';
const explanations={analyzed:'Showing research notes with a plain-language explanation, methodology, key results, limitations and interpretation.',all:'Showing every indexed paper. Look for the orange “Detailed analysis” label to find an explanation.',abstract:'Showing arXiv abstracts awaiting an editorial analysis; these are not independent research summaries.'};
function apply(){
 const q=input.value.toLowerCase().trim();let n=0;
 cards.forEach(c=>{const matchesMode=mode==='all'||c.dataset.readiness===(mode==='analyzed'?'analyzed':'abstract');const matchesTopic=topic==='all'||c.dataset.tags.toLowerCase().includes(topic.toLowerCase());const visible=matchesMode&&matchesTopic&&c.dataset.search.includes(q);c.hidden=!visible;if(visible)n++});
 document.querySelector('#no-results').hidden=n>0;
 document.querySelector('#result-count').textContent=n+' paper'+(n===1?'':'s')+' shown';
 document.querySelector('#view-explainer').textContent=explanations[mode];
}
function activate(buttons,selected,attr){buttons.forEach(b=>{const isSelected=b.dataset[attr]===selected;b.classList.toggle('active',isSelected);b.setAttribute('aria-pressed',String(isSelected))})}
input.addEventListener('input',apply);
modeButtons.forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;activate(modeButtons,mode,'mode');apply()}));
topicButtons.forEach(b=>b.addEventListener('click',()=>{topic=b.dataset.filter;activate(topicButtons,topic,'filter');apply()}));
document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();input.focus()}});
apply();
</script>
</Base>